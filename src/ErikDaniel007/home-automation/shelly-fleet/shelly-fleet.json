{
  "description": "Shelly relay/PM fleet — policy-only module for firewall rules (no VM)",
  "version": "1.0.0",
  "releaseDate": "2026-05-23",
  "maintainer": "@ErikDaniel007",
  "status": "Development",
  "tier": "app",
  "location": "/home/tappaas/Community/src/ErikDaniel007/home-automation/shelly-fleet",
  "vmname": "shelly-fleet",
  "vmtag": "TAPPaaS,Community,HomeAutomation,Hardware",
  "zone0": "iotCloud",
  "firewallType": "opnsense",
  "ports": [
    {
      "port": 80,
      "protocol": "TCP",
      "description": "Shelly HTTP API"
    }
  ],
  "egress": [
    {
      "to": "hassanova",
      "ports": [5683],
      "protocol": "UDP",
      "description": "Gen1 Shelly CoIoT push updates to Home Assistant (consumer egress, iotCloud lacks access-to srvHome by default)"
    }
  ],
  "discoveryMdns": true,
  "provides": [
    "control"
  ],
  "dependsOn": [
    "network:rules",
    "network:discovery"
  ]
}
