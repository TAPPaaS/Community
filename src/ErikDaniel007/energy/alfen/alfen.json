{
  "description": "Alfen Eve Pro EV charger — policy-only module for firewall rules (no VM)",
  "version": "0.1.0",
  "releaseDate": "2026-05-23",
  "maintainer": "@ErikDaniel007",
  "status": "Testing",
  "tier": "app",
  "location": "/home/tappaas/Community/src/ErikDaniel007/energy/alfen",
  "vmname": "alfen",
  "vmtag": "TAPPaaS,Community,Energy,Hardware",
  "zone0": "iotCloud",
  "aliasType": "host",
  "firewallType": "opnsense",
  "ports": [
    {
      "port": 80,
      "protocol": "TCP",
      "description": "Alfen web UI (HTTP)"
    },
    {
      "port": 443,
      "protocol": "TCP",
      "description": "Alfen web UI (HTTPS)"
    },
    {
      "port": 502,
      "protocol": "TCP",
      "description": "Modbus TCP (HA integration)"
    },
    {
      "port": 36549,
      "protocol": "UDP",
      "description": "Alfen discovery broadcast"
    }
  ],
  "ingress": [
    {
      "from": "home",
      "ports": [
        80,
        443
      ],
      "protocol": "TCP",
      "description": "Alfen web UI for Eve iPhone app (home zone)"
    },
    {
      "from": "home",
      "ports": [
        36549
      ],
      "protocol": "UDP",
      "description": "Alfen discovery for Eve app (home zone)"
    }
  ],
  "discoveryUdpRelay": [
    {
      "port": 36549,
      "zones": [
        "home",
        "iotCloud"
      ]
    }
  ],
  "provides": [
    "ui",
    "discovery",
    "modbus"
  ],
  "dependsOn": [
    "network:rules",
    "network:discovery",
    "network:snat"
  ],
  "config": {
    "network:snat": {
      "snatFrom": [
        "home",
        "srvHome"
      ],
      "snatReason": "Alfen NG5 firmware accepts TCP only from inside iotCloud (10.4.20.0/24); the Eve app on home and Home Assistant's Modbus client on srvHome are both outside it (#239)."
    }
  }
}
