# Webhost container: git mirrors, pinned artefacts and snapshot locks for the
# sites, over plain HTTP inside the DMZ. Integrity: apt checks signatures,
# artefacts are SHA-256 pinned, git content is what the site's repo holds.
{
	auto_https off
	admin localhost:2019
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /srv/webhost/www
	@hidden path /git/*/config /git/*/hooks/* /git/*/logs/*
	respond @hidden 404
	# Visitor analytics (D25): the tracker and its endpoint only, for the sites' proxies.
	route /_a/* {
		uri strip_prefix /_a
		@track path /script.js /api/send
		reverse_proxy @track 127.0.0.1:3000
		respond 404
	}
	file_server
	log {
		output stderr
		format json
	}
}
